<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.(js|css|gif|png|jpg|jpeg|svg|webp|ico|json|map|woff|woff2|ttf|eot|otf)$ [NC]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Powered-By "Hostinger Horizons"

  # DO NOT CACHE index.html or other HTML files
  # This ensures users always get the latest version of the app pointing to the correct JS/CSS files
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache all static assets (hashed by Vite) for a long time
  # These have hashes in their names, so if they change, the filename changes
  <If "%{REQUEST_URI} =~ m#^/assets/.*$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
